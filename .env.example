# Backend runtime
DATABASE_URL=postgresql://ark:ark@127.0.0.1:5432/ark_iv
# Used only by `just db-configure`; this connection needs role/database creation rights.
POSTGRES_ADMIN_URL=postgres
POSTGRES_APP_USER=ark
POSTGRES_APP_PASSWORD=ark
POSTGRES_APP_DATABASE=ark_iv
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
# Legacy compatibility only; normal API reads use compact cell_species_lists.
LOAD_EXPANDED_CELL_SPECIES=false
FRONTEND_ORIGIN=http://127.0.0.1:5173
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# IUCN website account used only by the browser-assisted spatial downloader.
# Never commit real values; keep them in the ignored local .env file.
IUCN_REDLIST_EMAIL=
IUCN_REDLIST_PASSWORD=
# Exact intended-use statement submitted with spatial download requests.
IUCN_USE_DESCRIPTION=
# Set true only after the account holder has accepted IUCN's terms and obtained
# the staged files through IUCN's official download route.
IUCN_DATA_AUTHORIZED=false
# Separate API v4 token for assessment-catalogue refreshes (not polygon downloads).
IUCN_REDLIST_KEY=

# Machine-specific large-data storage. Use an external disk when available.
GLOBAL_DATA_ROOT=./data/external
# Defaults to GLOBAL_DATA_ROOT/ark_iv_global_preview when omitted.
# GLOBAL_PREVIEW_ROOT=/path/to/serving-preview
# Existing packs default to GLOBAL_DATA_ROOT/h3_aggregated. For new builds use:
# GLOBAL_H3_ROOT=/path/to/Ark-IV_data/derived/iucn-richness-any-touch-v3/serving/current
# GLOBAL_CROSSWALK_PATH=./data/exports/iucn_goat_global/iucn_goat_crosswalk.parquet
# data-build/data-update refresh matches automatically under GLOBAL_DATA_ROOT.
# Use --crosswalk-mode require-current to select GLOBAL_CROSSWALK_PATH instead.
# Optional enrichment inputs; existing conventional paths are detected too.
# GLOBAL_GBIF_SPECIES_PATH=/path/to/gbif_backbone_species.tsv
# GLOBAL_EDGE_SPECIES_PATH=/path/to/2024_EDGE_species_external_with_gbif.tsv
# Active semantic profile and shared compute parallelism.
# SPATIAL_PROFILE=./config/spatial_semantics_iucn_richness_v3.toml
# Set a positive integer, or auto for a conservative CPU/memory-aware count.
PIPELINE_WORKERS=auto
# Optional stage overrides; --workers N overrides these for one complete run.
# SPATIAL_WORKERS=2
# RES7_WORKERS=2
# DUCKDB_THREADS=2
# TIPPECANOE_MAX_THREADS=2
# Per-process/helper pools default to one, independent of PIPELINE_WORKERS.
# RES7_THREADS=1
# TILE_DUCKDB_THREADS=1
# DUCKDB_MEMORY_LIMIT remains per process; multiple metric workers multiply it.

# Build/static storage (relative paths are resolved from the repository root)
DATA_DIR=./data
SOURCE_DUCKDB_PATH=./data/private/Ark-IV.duckdb
BUILD_DUCKDB_PATH=./data/private/precomputed_cache.duckdb
H3_DUCKDB_PATH=./data/denmark_h3.duckdb
TABULAR_DUCKDB_PATH=./data/denmark_tabular.duckdb
BORDERS_PATH=./data/denmark_borders.parquet
H3_RES3_PARQUET=./data/h3_res3_species.parquet
H3_RES7_PARQUET=./data/h3_res7_species.parquet
EXPORT_DIR=./data/exports
TILE_DIR=./data/tiles
PMTILES_PATH=./data/tiles/priorities.pmtiles
MAP_METADATA_PATH=./data/tiles/map-metadata.json
VALIDATION_REPORT_PATH=./data/validation/build-validation.json
TIPPECANOE_BIN=tippecanoe

# Global H3 files use (h3_cell, species_ids), where species_ids are IUCN
# internalTaxonId values. Set H3_ID_CROSSWALK_PATH to a Parquet file containing
# source_species_id or iucn_sis_id. app_species_id is optional and defaults to
# the IUCN ID. The legacy gbif_accepted_id target name is also accepted.
H3_ID_CROSSWALK_PATH=

# Large H3 aggregation pipeline
H3_INPUT_DIR=./data/h3_pairs
H3_ENCODED_DIR=./data/h3_encoded
H3_AGGREGATED_DIR=./data/h3_aggregated
# Optional serving partitions. When set, their row count supplies the homepage
# Small H3 Cells statistic and selected-cell lookups read from these files.
RES7_PARTS_DIR=
# New spatial stages default to GLOBAL_DATA_ROOT/scratch/spatial.
# DUCKDB_SCRATCH_DIR=/path/to/external/scratch
# DUCKDB_MEMORY_LIMIT=2GB
